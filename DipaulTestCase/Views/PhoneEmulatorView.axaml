<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:views="clr-namespace:DipaulTestCase.Views"
             xmlns:vm="clr-namespace:DipaulTestCase.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DipaulTestCase.Views.PhoneEmulatorView"
             x:DataType="vm:PhoneEmulatorViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:PhoneEmulatorViewModel />
  </Design.DataContext>

	<DockPanel>
		<ItemsControl x:Name="icPhoneButtons" DockPanel.Dock="Bottom" Margin="0,10" Width="400">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<views:PhoneButtonView />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<TextBox Margin="10" x:Name="tbPhoneMessageText" IsReadOnly="True" TextWrapping="Wrap" />
	</DockPanel>
</UserControl>
